# ============================================
# Mirror Download Server - Admin Only Config
# ============================================

# Server Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THIS TO A STRONG SECRET KEY!
API_KEY=change-this-to-strong-secret-key

# Google Drive Configuration
# Place credentials.json in same directory before first run
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Optional: Default Google Drive folder ID for downloads
GDRIVE_FOLDER_ID=

# Telegram Bot Configuration (optional)
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=
# Get your chat ID from @userinfobot (only this user can use the bot)
TELEGRAM_ADMIN_CHAT_ID=

# Celery / Redis Configuration (optional - for production/scale)
# USE_CELERY=false          # Set to 'true' to enable Celery (requires Redis)
# REDIS_URL=redis://localhost:6379/0
# See CELERY_SETUP.md for detailed configuration

# Download Settings
MAX_FILE_SIZE=5368709120
CHUNK_SIZE=8192
DOWNLOAD_TIMEOUT=3600
TEMP_DOWNLOAD_DIR=./downloads

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 
# This is a PRIVATE server - only admin can use it.
# 
# Option 1: Using EC2 IP only (HTTP)
#   - API works at: http://your-ec2-ip:8000
#   - Telegram webhook WON'T work (requires HTTPS)
#
# Option 2: Using ngrok (HTTPS) - RECOMMENDED for testing
#   1. Install ngrok: https://ngrok.com/download
#   2. Run: ngrok http 8000
#   3. Copy the https URL (e.g., https://abc123.ngrok.io)
#   4. Set Telegram webhook: 
#      curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://abc123.ngrok.io/webhook/telegram"
#
# Option 3: Using a domain (HTTPS) - RECOMMENDED for production
#   - Get free domain from duckdns.org or freenom.com
#   - Setup nginx and SSL
#   - Set Telegram webhook to your domain
