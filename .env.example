# ============================================
# Mirror Download Server - Production Config
# ============================================

# Server Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THIS TO A STRONG SECRET KEY!
API_KEY=change-this-to-strong-secret-key

# Google Drive Configuration
# Place credentials.json in same directory before first run
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Optional: Default Google Drive folder ID
GDRIVE_FOLDER_ID=

# User Folder Separation (Optional - auto-created if left empty)
# GDRIVE_PUBLIC_FOLDER_ID=       # Folder for guest users (auto-created as 'Public' if empty)
# GDRIVE_USERS_ROOT_FOLDER_ID=   # Root folder for user folders (auto-created as 'Users' if empty)
# Note: Leave empty to auto-create folders on first use

# Telegram Bot Configuration (optional but recommended)
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=
# Get your chat ID from @userinfobot (this user will be admin)
TELEGRAM_ADMIN_CHAT_ID=

# Bot Access Control
# - Admin can generate codes with /gencode
# - Users must use /auth CODE to access
# - Admin is automatically authorized
CODE_EXPIRY_HOURS=24        # Access codes expire after N hours if not used (0 = never expire)
USER_ACCESS_DURATION_HOURS=168  # How long users stay authorized after using code (0 = never expire, default 7 days)
MAX_CODES_PER_ADMIN=10      # Maximum active codes per admin

# Admin Telegram Commands:
# /admin      - Show admin menu
# /gencode    - Generate access code
# /codes      - List all codes
# /settings   - View/change settings
# /setexpiry  - Change code expiry (hours)
# /setmaxcodes - Change max codes per admin
# /setmaxsize - Change max file size (GB)

# Celery / Redis Configuration (optional - for production/scale)
# USE_CELERY=false          # Set to 'true' to enable Celery (requires Redis)
# REDIS_URL=redis://localhost:6379/0
# See CELERY_SETUP.md for detailed configuration

# Download Settings
MAX_FILE_SIZE=5368709120
CHUNK_SIZE=8192
DOWNLOAD_TIMEOUT=3600
TEMP_DOWNLOAD_DIR=./downloads

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 
# Option 1: Using EC2 IP only (HTTP)
#   - API works at: http://your-ec2-ip:8000
#   - Telegram webhook WON'T work (requires HTTPS)
#
# Option 2: Using ngrok (HTTPS) - RECOMMENDED for testing
#   1. Install ngrok: https://ngrok.com/download
#   2. Run: ngrok http 8000
#   3. Copy the https URL (e.g., https://abc123.ngrok.io)
#   4. Set Telegram webhook: 
#      curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://abc123.ngrok.io/webhook/telegram"
#
# Option 3: Using a domain (HTTPS) - RECOMMENDED for production
#   - Get free domain from duckdns.org or freenom.com
#   - Run: sudo ./setup_nginx.sh
#   - Follow SSL setup instructions
